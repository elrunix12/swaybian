{
    "layer": "top",
    "position": "top",
    "height": 20,
    "spacing": 4,
    
    "modules-left": ["sway/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["network", "pulseaudio", "battery", "idle_inhibitor"],

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}"
    },

    "clock": {
        "format": "{:%H:%M  |  %d/%m/%Y}",
	"on-click": "gsimplecal",
	"tooltip": false
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% ",
        "format-plugged": "{capacity}% ",
        "format-icons": ["", "", "", "", ""]
    },

    "network": {
        "format": "Sem Rede ⚠",
        "format-wifi": "{essid} ",
        "format-ethernet": "Conectado ",
        "format-linked": "Conectando... ⚠",
        "format-disconnected": "Sem Rede ⚠",
        "tooltip-format": "{ifname} via {gwaddr}",
        "on-click": "bash ~/.config/sway/apps/internet.sh &"
    },

    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-bluetooth": "{volume}% {icon}",
        "format-muted": "Mutado ",
        "format-icons": {
            "headphone": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },

     "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "", // Ícone de olho aberto (Inibido/Não vai dormir)
            "deactivated": "" // Ícone de olho fechado (Normal/Vai dormir)
        },
        "tooltip": true,
        "tooltip-format-activated": "Modo Cafeína: Ativado (Não vai suspender)",
        "tooltip-format-deactivated": "Modo Cafeína: Desativado"
    }
}
